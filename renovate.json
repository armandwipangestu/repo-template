{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "group:monorepos",
    "group:recommended",
    "replacements:all",
    "workarounds:all"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group all non-major updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major",
      "groupSlug": "non-major"
    },
    {
      "description": "Group all major updates (but still create separate PRs)",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Auto-merge minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Group Bun-related updates",
      "matchPackagePatterns": ["bun"],
      "groupName": "bun"
    },
    {
      "description": "Group ESLint-related updates",
      "matchPackagePatterns": ["eslint"],
      "groupName": "eslint"
    },
    {
      "description": "Group semantic-release updates",
      "matchPackagePatterns": ["semantic-release"],
      "groupName": "semantic-release"
    },
    {
      "description": "Group CI/CD tool updates",
      "matchManagers": ["gitlabci"],
      "groupName": "ci-cd",
      "labels": ["ci", "dependencies"]
    }
  ],
  "ignoreDeps": [],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "schedule": ["before 6am on monday"],
  "timezone": "Asia/Jakarta"
}
